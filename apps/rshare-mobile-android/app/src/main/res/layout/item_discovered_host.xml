<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/mobile_host_card" android:orientation="vertical" android:padding="18dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="72dp" android:layout_height="72dp"
            android:background="@drawable/mobile_device_tile" android:padding="14dp"
            android:src="@drawable/mobile_desktop_icon" android:contentDescription="电脑" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/host_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="#F1F7F3" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/host_address" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#A7B9AD" android:textSize="14sp" />
            <TextView android:id="@+id/host_pair_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="● 已发现，可请求配对" android:textColor="#E7C76F" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <Button android:id="@+id/host_pair_button" android:layout_width="match_parent"
        android:layout_height="54dp" android:layout_marginTop="20dp"
        android:background="@drawable/mobile_primary_button" android:backgroundTint="@null"
        android:text="请求配对" android:textAllCaps="false" android:textColor="#0A241A"
        android:textSize="16sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:gravity="center" android:text="请在电脑端确认此设备"
        android:textColor="#91A69B" android:textSize="12sp" />
</LinearLayout>
