; R-ShareMouse virtual display UMDF/IddCx driver package.

[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
ClassVer=2.0
Provider=%ManufacturerName%
DriverVer=05/28/2026,0.1.0.0
CatalogFile=rshare-vdisplay.cat
PnpLockDown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...22000

[Standard.NTamd64.10.0...22000]
%DeviceName%=RShareVDisplay_Install, ROOT\RShareVDisplay

[SourceDisksFiles]
rshare-vdisplay.dll=1

[SourceDisksNames]
1=%DiskName%

[RShareVDisplay_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=RShareVDisplay_CopyFiles

[RShareVDisplay_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=RShareVDisplay_HardwareSettings

[RShareVDisplay_HardwareSettings]
HKR,, "UpperFilters", %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "RShareMouseVirtualDisplay"
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GA;;;UD)(A;;GA;;;BU)"

[RShareVDisplay_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[RShareVDisplay_Install.NT.Wdf]
UmdfService=RShareVDisplay,RShareVDisplay_UmdfService
UmdfServiceOrder=RShareVDisplay
UmdfKernelModeClientPolicy=AllowKernelModeClients

[RShareVDisplay_UmdfService]
UmdfLibraryVersion=2.25
ServiceBinary=%12%\UMDF\rshare-vdisplay.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
RShareVDisplay_CopyFiles=12,UMDF

[RShareVDisplay_CopyFiles]
rshare-vdisplay.dll

[Strings]
ManufacturerName="R-ShareMouse"
DiskName="R-ShareMouse virtual display driver disk"
DeviceName="R-ShareMouse Virtual Display"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000
